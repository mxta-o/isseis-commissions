PORT=4000
NODE_ENV=development
# Origin allowed by CORS (the Vite dev server, or the deployed frontend)
CLIENT_URL=http://localhost:3001
# Base URL used for links in emails (status page deep links)
PUBLIC_SITE_URL=http://localhost:3001

# comma-separated emails allowed into the admin console (must also exist in Supabase Auth)
ADMIN_EMAILS=

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
# Secret: bypasses RLS. Server only — never put this in client/.env.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=commissions

RESEND_API_KEY=
# onboarding@resend.dev only delivers to your own Resend account email until a domain is verified
RESEND_FROM_EMAIL=onboarding@resend.dev
# Where "new commission" alerts go (Loraine). Optional.
NOTIFY_EMAIL=

KOFI_URL=https://ko-fi.com/isseimx
