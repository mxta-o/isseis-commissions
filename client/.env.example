# required for production builds (the build fails without it); dev falls back to http://localhost:4000
VITE_API_URL=http://localhost:4000

# public values (safe in the browser): used only for the admin login.
# never put the service_role / secret key here — anything prefixed VITE_ ships to every visitor.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=

# shown on the Terms and Privacy pages as the contact address (optional; without it they point to the artist's Ko-fi)
VITE_CONTACT_EMAIL=
